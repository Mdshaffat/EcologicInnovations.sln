@model CaliforniumCore.Web.ViewModels.Products.ProductDetailsViewModel

@{
    ViewData["Title"] = Model.Title;
}

@section Styles {
    <link rel="stylesheet" href="~/css/product-details.css" asp-append-version="true" />
}

<section class="page-hero">
    <div class="container">
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item"><a asp-controller="Products" asp-action="Index">Products</a></li>
                @if (!string.IsNullOrWhiteSpace(Model.CategorySlug) && !string.IsNullOrWhiteSpace(Model.CategoryName))
                {
                    <li class="breadcrumb-item"><a asp-controller="Products" asp-action="Index" asp-route-category="@Model.CategorySlug">@Model.CategoryName</a></li>
                }
                <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
            </ol>
        </nav>

        <h1 class="display-5 fw-bold text-white mb-2">@Model.Title</h1>
        @if (!string.IsNullOrWhiteSpace(Model.ShortDescription))
        {
            <p class="lead text-white-50 mb-0">@Model.ShortDescription</p>
        }
    </div>
</section>

<div class="product-details-page py-5">
    <div class="container">
        <div class="row g-4 g-xl-5 mb-5">
            <div class="col-lg-6">
                @if (Model.VideoEmbed is not null)
                {
                    <partial name="_VideoEmbedPanel" model="Model.VideoEmbed" />
                }
                else
                {
                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                        @if (!string.IsNullOrWhiteSpace(Model.MainImageUrl))
                        {
                            <img src="@Model.MainImageUrl"
                                 alt="@Model.Title"
                                 class="product-main-image" />
                        }
                        else
                        {
                            <div class="product-image-placeholder d-flex align-items-center justify-content-center bg-light">
                                <div class="text-center text-muted">
                                    <i class="bi bi-box-seam fs-1 d-block mb-2"></i>
                                    <span>No product image</span>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="col-lg-6">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body p-4 p-lg-5 d-flex flex-column">
                        @if (!string.IsNullOrWhiteSpace(Model.CategoryName))
                        {
                            <span class="badge text-bg-success-subtle text-success-emphasis align-self-start mb-3">
                                @Model.CategoryName
                            </span>
                        }

                        <h1 class="display-6 fw-bold mb-3">@Model.Title</h1>

                        @if (!string.IsNullOrWhiteSpace(Model.ShortDescription))
                        {
                            <p class="lead text-secondary mb-4">@Model.ShortDescription</p>
                        }

                        @if (!string.IsNullOrWhiteSpace(Model.CompanyPhone))
                        {
                            <div class="d-flex align-items-center gap-3 mb-4">
                                <div class="product-contact-icon">
                                    <i class="bi bi-telephone"></i>
                                </div>
                                <div>
                                    <div class="small text-secondary text-uppercase">Phone</div>
                                    <a href="tel:@Model.CompanyPhone" class="fw-semibold text-dark">@Model.CompanyPhone</a>
                                </div>
                            </div>
                        }

                        <div class="mt-auto d-flex flex-wrap gap-3">
                            @if (Model.ContactFormEnabled)
                            {
                                <a class="btn btn-success btn-lg px-4" href="#inquiry-form">
                                    <i class="bi bi-chat-dots me-2"></i>@Model.ContactFormTitle
                                </a>
                            }
                            <a asp-controller="Products" asp-action="Index" class="btn btn-outline-success btn-lg px-4">
                                All Products
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4 g-xl-5">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-body p-4 p-lg-5">
                        <div class="product-html-content html-content">
                            @Html.Raw(Model.HtmlDetails)
                        </div>
                    </div>
                </div>

                @if (Model.ContactFormEnabled)
                {
                    <div class="card border-0 shadow-sm rounded-4 mt-4" id="inquiry-form">
                        <div class="card-body p-4 p-lg-5">
                            <h2 class="h3 mb-2">@Model.ContactFormTitle</h2>
                            <p class="text-secondary mb-4">Send us your question or inquiry about this product.</p>

                            @if (Model.InquirySubmittedSuccessfully)
                            {
                                <div class="alert alert-success core-success-callout d-flex align-items-start gap-3 rounded-4 shadow-sm border-0 py-3 px-4 mb-4" id="successMessage">
                                    <div class="flex-shrink-0 mt-1">
                                        <i class="bi bi-check-circle-fill fs-4 core-success-icon"></i>
                                    </div>
                                    <div>
                                        <strong class="d-block mb-1">Message Sent!</strong>
                                        <span>@Model.SuccessMessage</span>
                                    </div>
                                </div>
                            }

                            @if (!Model.InquirySubmittedSuccessfully && !ViewData.ModelState.IsValid && ViewData.ModelState.Any(m => m.Value?.Errors.Count > 0))
                            {
                                <div class="alert alert-danger d-flex align-items-start gap-3 rounded-4 border-0 py-3 px-4 mb-4" role="alert">
                                    <div class="flex-shrink-0 mt-1">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                                            <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.436-.99.98-1.767zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5m.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2"/>
                                        </svg>
                                    </div>
                                    <div>
                                        <strong>Please fix the errors below.</strong>
                                        <div class="small mt-1">One or more fields need your attention before submitting.</div>
                                    </div>
                                </div>
                            }

                            <form asp-action="SendInquiry" asp-controller="Products" asp-route-slug="@Model.Slug" method="post" novalidate>
                                @Html.AntiForgeryToken()

                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label asp-for="InquiryForm.Name" class="form-label">Name</label>
                                        <input asp-for="InquiryForm.Name" class="form-control" />
                                        <span asp-validation-for="InquiryForm.Name" class="text-danger small"></span>
                                    </div>

                                    <div class="col-md-6">
                                        <label asp-for="InquiryForm.Email" class="form-label">Email</label>
                                        <input asp-for="InquiryForm.Email" class="form-control" />
                                        <span asp-validation-for="InquiryForm.Email" class="text-danger small"></span>
                                    </div>

                                    <div class="col-md-6">
                                        <label asp-for="InquiryForm.Phone" class="form-label">Phone</label>
                                        <input asp-for="InquiryForm.Phone" class="form-control" />
                                        <span asp-validation-for="InquiryForm.Phone" class="text-danger small"></span>
                                    </div>

                                    <div class="col-12">
                                        <label asp-for="InquiryForm.Message" class="form-label">Message</label>
                                        <textarea asp-for="InquiryForm.Message" class="form-control" rows="5"></textarea>
                                        <span asp-validation-for="InquiryForm.Message" class="text-danger small"></span>
                                    </div>
                                </div>

                                <div class="mt-4">
                                    <button type="submit" class="btn btn-success btn-lg px-4">
                                        <i class="bi bi-send me-2"></i>Send Message
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                }
            </div>

            <aside class="col-lg-4">
                @if (Model.RelatedProducts.Any())
                {
                    <div class="card border-0 shadow-sm rounded-4 sticky-lg-top sidebar-sticky-offset">
                        <div class="card-body p-4">
                            <h2 class="h5 mb-3">Related Products</h2>
                            <div class="d-grid gap-3">
                                @foreach (var item in Model.RelatedProducts)
                                {
                                    <a asp-controller="Products" asp-action="Details" asp-route-slug="@item.Slug"
                                       class="related-product-link text-decoration-none d-flex align-items-center gap-3">
                                        <div class="related-product-icon">
                                            <i class="bi bi-box-seam"></i>
                                        </div>
                                        <span class="fw-semibold text-dark">@item.Title</span>
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                }
            </aside>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    @if (Model.InquirySubmittedSuccessfully || !ViewData.ModelState.IsValid)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                var el = document.getElementById('@(Model.InquirySubmittedSuccessfully ? "successMessage" : "inquiry-form")');
                if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
            });
        </script>
    }
}
