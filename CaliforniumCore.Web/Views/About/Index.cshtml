@model CaliforniumCore.Web.ViewModels.About.AboutPageViewModel

@section Styles {
    <link rel="stylesheet" href="~/css/about.css" asp-append-version="true" />
}

<section class="page-hero">
    <div class="container">
        @if (Model.Breadcrumbs?.Count > 0)
        {
            <nav aria-label="breadcrumb" class="mb-3">
                <ol class="breadcrumb mb-0">
                    @foreach (var crumb in Model.Breadcrumbs)
                    {
                        if (crumb.IsActive || string.IsNullOrWhiteSpace(crumb.Url))
                        {
                            <li class="breadcrumb-item active" aria-current="page">@crumb.Title</li>
                        }
                        else
                        {
                            <li class="breadcrumb-item">
                                <a href="@crumb.Url">@crumb.Title</a>
                            </li>
                        }
                    }
                </ol>
            </nav>
        }

        <span class="page-hero-kicker">Californium Core</span>
        <h1 class="display-5 fw-bold text-white mb-2">@Model.Title</h1>

        @if (!string.IsNullOrWhiteSpace(Model.ShortIntro))
        {
            <p class="lead text-white-50 mb-0">@Model.ShortIntro</p>
        }
    </div>
</section>

<section class="about-main-section py-5 py-lg-6">
    <div class="container">
        <div class="row g-4 g-xl-5">
            <div class="col-12 col-lg-4">
                <div class="about-side-card card border-0 shadow-sm h-100">
                    <div class="card-body p-4 p-xl-5">
                        <span class="about-side-kicker">Who we are</span>
                        <h2 class="h3 fw-bold mb-3">Scientific technology for complex work</h2>
                        <p class="text-secondary mb-4">
                            We build reliable software and applied systems for medical, chemical, materials, and technical operations where accuracy matters.
                        </p>

                        <div class="about-side-stat-list">
                            <div class="about-side-stat">
                                <strong>Scientific Software</strong>
                                <span>Web, desktop, and workflow applications</span>
                            </div>
                            <div class="about-side-stat">
                                <strong>Medical Systems</strong>
                                <span>Clinic, lab, record, and operational tools</span>
                            </div>
                            <div class="about-side-stat">
                                <strong>Chemical Workflows</strong>
                                <span>Formula, quality, sample, and lab data support</span>
                            </div>
                            <div class="about-side-stat">
                                <strong>Materials Intelligence</strong>
                                <span>Structured systems for materials and experiments</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-8">
                <div class="card border-0 shadow-sm about-content-card">
                    <div class="card-body p-4 p-xl-5">
                        @if (!string.IsNullOrWhiteSpace(Model.HtmlContent))
                        {
                            <div class="about-rich-content">
                                @Html.Raw(Model.HtmlContent)
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-5">
                                <h2 class="h4 fw-semibold mb-3">Content is coming soon</h2>
                                <p class="text-secondary mb-0">
                                    The About Us page has not been fully updated yet.
                                </p>
                            </div>
                        }
                    </div>
                </div>

                <div class="about-cta-panel mt-4 mt-xl-5">
                    <div class="row g-3 align-items-center">
                        <div class="col-lg-8">
                            <span class="about-side-kicker">Let’s work together</span>
                            <h2 class="h3 fw-bold mb-2">Looking for scientific software or operational systems?</h2>
                            <p class="text-secondary mb-0">
                                Explore what we offer or get in touch for a new product, workflow, research, or technical operations project.
                            </p>
                        </div>
                        <div class="col-lg-4">
                            <div class="d-flex flex-wrap gap-3 justify-content-lg-end">
                                <a asp-controller="Products" asp-action="Index" class="btn btn-success btn-lg px-4">
                                    <i class="bi bi-box-seam me-1"></i> View Products
                                </a>
                                <a asp-controller="Contact" asp-action="Index" class="btn btn-outline-success btn-lg px-4">
                                    <i class="bi bi-chat-dots me-1"></i> Contact Us
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.GoogleMapEmbedUrl))
                {
                    <section class="about-map-panel mt-4 mt-xl-5" aria-labelledby="aboutMapTitle">
                        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-2 mb-3">
                            <div>
                                <span class="about-side-kicker">Location</span>
                                <h2 class="h3 fw-bold mb-0" id="aboutMapTitle">Find Californium Core</h2>
                            </div>
                            <a href="@Model.GoogleMapEmbedUrl" target="_blank" rel="noopener noreferrer" class="btn btn-outline-success btn-sm rounded-pill px-3">
                                <i class="bi bi-box-arrow-up-right me-1"></i> Open Map
                            </a>
                        </div>

                        <div class="about-map-frame">
                            <iframe src="@Model.GoogleMapEmbedUrl"
                                    title="Californium Core location map"
                                    loading="lazy"
                                    referrerpolicy="no-referrer-when-downgrade"
                                    allowfullscreen></iframe>
                        </div>
                    </section>
                }
            </div>
        </div>
    </div>
</section>
