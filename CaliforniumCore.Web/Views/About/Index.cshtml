@model CaliforniumCore.Web.ViewModels.About.AboutPageViewModel

@section Styles {
    <link rel="stylesheet" href="~/css/about.css" asp-append-version="true" />
}

<section class="page-hero">
    <div class="container">
        @if (Model.Breadcrumbs?.Count > 0)
        {
            <nav aria-label="breadcrumb" class="mb-3">
                <ol class="breadcrumb mb-0">
                    @foreach (var crumb in Model.Breadcrumbs)
                    {
                        if (crumb.IsActive || string.IsNullOrWhiteSpace(crumb.Url))
                        {
                            <li class="breadcrumb-item active" aria-current="page">@crumb.Title</li>
                        }
                        else
                        {
                            <li class="breadcrumb-item">
                                <a href="@crumb.Url">@crumb.Title</a>
                            </li>
                        }
                    }
                </ol>
            </nav>
        }

        <span class="page-hero-kicker">Californium Core</span>
        <h1 class="display-5 fw-bold text-white mb-2">@Model.Title</h1>

        @if (!string.IsNullOrWhiteSpace(Model.ShortIntro))
        {
            <p class="lead text-white-50 mb-0">@Model.ShortIntro</p>
        }
    </div>
</section>

<section class="about-main-section py-5 py-lg-6">
    <div class="container">
        <div class="row g-4 g-xl-5">
            <div class="col-12">
                <div class="card border-0 shadow-sm about-content-card">
                    <div class="card-body p-4 p-xl-5">
                        @if (!string.IsNullOrWhiteSpace(Model.HtmlContent))
                        {
                            <div class="about-rich-content">
                                @Html.Raw(Model.HtmlContent)
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-5">
                                <h2 class="h4 fw-semibold mb-3">Content is coming soon</h2>
                                <p class="text-secondary mb-0">
                                    The About Us page has not been fully updated yet.
                                </p>
                            </div>
                        }
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.GoogleMapEmbedUrl))
                {
                    <section class="about-map-panel mt-4 mt-xl-5" aria-labelledby="aboutMapTitle">
                        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-2 mb-3">
                            <div>
                                <span class="about-side-kicker">Location</span>
                                <h2 class="h3 fw-bold mb-0" id="aboutMapTitle">Find Californium Core</h2>
                            </div>
                            <a href="@Model.GoogleMapEmbedUrl" target="_blank" rel="noopener noreferrer" class="btn btn-outline-success btn-sm rounded-pill px-3">
                                <i class="bi bi-box-arrow-up-right me-1"></i> Open Map
                            </a>
                        </div>

                        <div class="about-map-frame">
                            <iframe src="@Model.GoogleMapEmbedUrl"
                                    title="Californium Core location map"
                                    loading="lazy"
                                    referrerpolicy="no-referrer-when-downgrade"
                                    allowfullscreen></iframe>
                        </div>
                    </section>
                }
            </div>
        </div>
    </div>
</section>
