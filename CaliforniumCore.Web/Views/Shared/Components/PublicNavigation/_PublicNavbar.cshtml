@model CaliforniumCore.Web.ViewModels.Shared.PublicNavigationViewModel

@{
    bool IsActive(string path)
    {
        if (string.IsNullOrWhiteSpace(Model.CurrentPath))
        {
            return false;
        }

        if (path == "/")
        {
            return string.Equals(Model.CurrentPath, "/", StringComparison.OrdinalIgnoreCase);
        }

        return Model.CurrentPath.StartsWith(path, StringComparison.OrdinalIgnoreCase);
    }

    var hasProductMenuItems = Model.ProductMenuItems.Any();
    var siteNameParts = (Model.SiteName ?? "Californium Core").Split(' ', 2, StringSplitOptions.RemoveEmptyEntries);
    var brandFirstLine = siteNameParts.Length > 0 ? siteNameParts[0] : "Californium";
    var brandSecondLine = siteNameParts.Length > 1 ? siteNameParts[1] : "Core";
}

<nav class="navbar navbar-expand-lg navbar-light bg-white sticky-top public-navbar">
    <div class="container">
        <a class="navbar-brand public-navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index">
            @if (!string.IsNullOrWhiteSpace(Model.LogoUrl))
            {
                <img src="@Model.LogoUrl"
                     alt="@Model.SiteName"
                     class="public-navbar-logo" />
            }

            <span class="public-navbar-brand-text">
                <span>@brandFirstLine</span>
                <strong>@brandSecondLine</strong>
            </span>
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#publicNavbar"
                aria-controls="publicNavbar" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="publicNavbar">
            <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-3 public-navbar-nav">
                <li class="nav-item">
                    <a class="nav-link @(IsActive("/") ? "active" : null)" asp-controller="Home" asp-action="Index">Home</a>
                </li>

                <li class="nav-item">
                    <a class="nav-link @(IsActive("/about-us") ? "active" : null)" asp-controller="About" asp-action="Index">About Us</a>
                </li>

                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle @(IsActive("/products") ? "active" : null)"
                       href="#"
                       id="productsDropdown"
                       role="button"
                       data-bs-toggle="dropdown"
                       aria-expanded="false">
                        Solutions
                    </a>

                    <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 public-navbar-dropdown"
                        aria-labelledby="productsDropdown">
                        <li>
                            <a class="dropdown-item public-navbar-dropdown-item" asp-controller="Products" asp-action="Index">
                                <span class="public-navbar-dropdown-icon"><i class="bi bi-grid-3x3-gap"></i></span>
                                <span>
                                    <strong>All Solutions</strong>
                                    <small>Browse every system and product</small>
                                </span>
                            </a>
                        </li>

                        @if (hasProductMenuItems)
                        {
                            <li><hr class="dropdown-divider" /></li>

                            @foreach (var item in Model.ProductMenuItems)
                            {
                                <li>
                                    <a class="dropdown-item public-navbar-dropdown-item" href="@item.Url">
                                        <span class="public-navbar-dropdown-icon"><i class="bi bi-box-seam"></i></span>
                                        <span>
                                            <strong>@item.Title</strong>
                                            <small>View details</small>
                                        </span>
                                    </a>
                                </li>
                            }
                        }
                    </ul>
                </li>

                <li class="nav-item">
                    <a class="nav-link @(IsActive("/blog") ? "active" : null)" asp-controller="Blog" asp-action="Index">Articles</a>
                </li>

                <li class="nav-item">
                    <a class="nav-link @(IsActive("/policy") ? "active" : null)" asp-controller="Policy" asp-action="Index">Policy</a>
                </li>

                <li class="nav-item ms-lg-2">
                    <a asp-controller="Contact" asp-action="Index" class="btn public-navbar-cta">
                        Get In Touch
                    </a>
                </li>
            </ul>
        </div>
    </div>
</nav>
