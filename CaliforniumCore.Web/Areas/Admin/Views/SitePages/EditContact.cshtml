@model CaliforniumCore.Web.ViewModels.Admin.SitePageEditorViewModel

<div class="row g-4">
    <div class="col-12 col-xl-8">
        <div class="card border-0 shadow-sm admin-card">
            <div class="card-body p-4">
                <form asp-area="Admin" asp-controller="SitePages" asp-action="EditContact" method="post" novalidate>
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small"></div>

                    <input asp-for="Id" type="hidden" />
                    <input asp-for="PageKey" type="hidden" />

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold"></label>
                        <input asp-for="Title" class="form-control form-control-lg" placeholder="Contact Us" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Slug" class="form-label fw-semibold"></label>
                            <input asp-for="Slug" class="form-control" readonly />
                            <div class="form-text">
                                The Contact page uses a fixed public route at <code>/contact</code>.
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="SortOrder" class="form-label fw-semibold"></label>
                            <input asp-for="SortOrder" class="form-control" />
                            <span asp-validation-for="SortOrder" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mt-3">
                        <label asp-for="BannerImageUrl" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <input asp-for="BannerImageUrl"
                                   class="form-control admin-image-url-input"
                                   placeholder="/uploads/media/pages/contact-banner.jpg"
                                   data-upload-url="@Url.Action("EditorUpload", "Media", new { area = "Admin" })"
                                   data-media-group="Pages" />
                            <button type="button" class="btn btn-outline-secondary btn-upload-media-url" title="Upload image" aria-label="Upload image">
                                <i class="bi bi-upload"></i>
                            </button>
                            <button type="button" class="btn btn-outline-secondary btn-select-media" title="Enter media URL" aria-label="Enter media URL">
                                <i class="bi bi-folder2-open"></i>
                            </button>
                        </div>
                        <span asp-validation-for="BannerImageUrl" class="text-danger small"></span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.BannerImageUrl))
                    {
                        <div class="mt-3">
                            <div class="small text-muted mb-2">Current Banner Preview</div>
                            <img src="@Model.BannerImageUrl" alt="Contact banner" class="img-fluid rounded border" />
                        </div>
                    }

                    <div class="mt-3">
                        <label asp-for="ShortIntro" class="form-label fw-semibold"></label>
                        <textarea asp-for="ShortIntro" class="form-control" rows="4" placeholder="Short introduction shown under the Contact page title."></textarea>
                        <span asp-validation-for="ShortIntro" class="text-danger small"></span>
                    </div>

                    <div class="mt-3">
                        <label asp-for="HtmlContent" class="form-label fw-semibold"></label>
                        <textarea asp-for="HtmlContent"
                                  class="form-control font-monospace"
                                  rows="20"
                                  placeholder="<section><h2>How can we help?</h2><p>Your contact page content here...</p></section>"
                                  data-rich-editor="true"
                                  data-editor-upload-url="@Url.Action("EditorUpload", "Media", new { area = "Admin" })"
                                  data-media-group="Pages"></textarea>
                        <span asp-validation-for="HtmlContent" class="text-danger small"></span>
                        <div class="form-text">
                            Content is sanitized before save.
                        </div>
                    </div>

                    <hr class="my-4" />

                    <h5 class="mb-3">SEO Settings</h5>

                    <div class="mb-3">
                        <label asp-for="MetaTitle" class="form-label fw-semibold"></label>
                        <input asp-for="MetaTitle" class="form-control" placeholder="Contact Us | Californium Core" />
                        <span asp-validation-for="MetaTitle" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="MetaDescription" class="form-label fw-semibold"></label>
                        <textarea asp-for="MetaDescription" class="form-control" rows="3" placeholder="Short SEO description for the Contact page."></textarea>
                        <span asp-validation-for="MetaDescription" class="text-danger small"></span>
                    </div>

                    <div class="form-check form-switch mb-4">
                        <input asp-for="IsPublished" class="form-check-input" />
                        <label asp-for="IsPublished" class="form-check-label fw-semibold"></label>
                    </div>

                    <div class="d-flex flex-wrap gap-2">
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-save me-1"></i> Save Contact
                        </button>

                        <a asp-area="" asp-controller="Contact" asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-eye me-1"></i> View Public Page
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-12 col-xl-4">
        <div class="card border-0 shadow-sm admin-card">
            <div class="card-body p-4">
                <h5 class="mb-3">Sanitized Preview</h5>

                @if (!string.IsNullOrWhiteSpace(Model.PreviewHtml))
                {
                    <div class="border rounded-4 p-3 bg-light-subtle about-admin-preview">
                        @Html.Raw(Model.PreviewHtml)
                    </div>
                }
                else
                {
                    <div class="text-muted small">
                        Preview will appear here after content is added.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
