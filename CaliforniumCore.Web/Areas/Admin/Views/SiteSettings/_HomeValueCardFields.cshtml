@model (string Number, string IconName, string? IconValue, string TitleName, string? TitleValue, string DescriptionName, string? DescriptionValue)

@{
    string FieldValue(string key, string? currentValue)
    {
        if (ViewData.ModelState.TryGetValue(key, out var entry) &&
            entry.AttemptedValue is not null)
        {
            return entry.AttemptedValue;
        }

        return currentValue ?? string.Empty;
    }
}

<div class="col-md-6 col-xl-3">
    <div class="border rounded-3 p-3 h-100">
        <h3 class="h6 mb-3">Card @Model.Number</h3>
        <div class="mb-3">
            <label for="@Model.IconName" class="form-label">Icon CSS</label>
            <input id="@Model.IconName" name="@Model.IconName" value="@FieldValue(Model.IconName, Model.IconValue)" class="form-control" placeholder="bi bi-cpu" />
        </div>
        <div class="mb-3">
            <label for="@Model.TitleName" class="form-label">Title</label>
            <input id="@Model.TitleName" name="@Model.TitleName" value="@FieldValue(Model.TitleName, Model.TitleValue)" class="form-control" />
        </div>
        <div>
            <label for="@Model.DescriptionName" class="form-label">Description</label>
            <textarea id="@Model.DescriptionName" name="@Model.DescriptionName" class="form-control" rows="4">@FieldValue(Model.DescriptionName, Model.DescriptionValue)</textarea>
        </div>
    </div>
</div>
