@model (string Number, string IconName, string TitleName, string DescriptionName)

@{
    string FieldValue(string key)
    {
        if (ViewData.ModelState.TryGetValue(key, out var entry) &&
            entry.AttemptedValue is { Length: > 0 } attempted)
        {
            return attempted;
        }

        return Convert.ToString(ViewData.Eval(key)) ?? string.Empty;
    }
}

<div class="col-md-6 col-xl-3">
    <div class="border rounded-3 p-3 h-100">
        <h3 class="h6 mb-3">Card @Model.Number</h3>
        <div class="mb-3">
            <label for="@Model.IconName" class="form-label">Icon CSS</label>
            <input id="@Model.IconName" name="@Model.IconName" value="@FieldValue(Model.IconName)" class="form-control" placeholder="bi bi-cpu" />
        </div>
        <div class="mb-3">
            <label for="@Model.TitleName" class="form-label">Title</label>
            <input id="@Model.TitleName" name="@Model.TitleName" value="@FieldValue(Model.TitleName)" class="form-control" />
        </div>
        <div>
            <label for="@Model.DescriptionName" class="form-label">Description</label>
            <textarea id="@Model.DescriptionName" name="@Model.DescriptionName" class="form-control" rows="4">@FieldValue(Model.DescriptionName)</textarea>
        </div>
    </div>
</div>
